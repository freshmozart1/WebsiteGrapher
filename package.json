{
  "name": "website-grapher",
  "version": "0.1.0",
  "private": true,
  "description": "Learns the structure of a website once and answers navigation questions from a stored semantic graph.",
  "type": "module",
  "bin": {
    "wgraph": "./dist/cli/index.js"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "wgraph": "tsx src/cli/index.ts",
    "test": "vitest run",
    "test:unit": "vitest run test/unit",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "playwright": "^1.62.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^22.15.3",
    "tsx": "^4.20.3",
    "typescript": "^5.8.3",
    "vitest": "^3.1.3"
  }
}
